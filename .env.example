# Copy to .env and fill in what you have. Every key is optional: without them the
# app still works, you just type MOT and tax dates in by hand.

# DVLA Vehicle Enquiry Service: tax status and due date
DVLA_API_KEY=

# DVSA MOT History API: make, model, MOT dates, full MOT history
MOT_CLIENT_ID=
MOT_CLIENT_SECRET=
MOT_API_KEY=
# Only if DVSA gives you different values from the defaults
# MOT_SCOPE=https://tut.api.gov.uk/.default
# MOT_TOKEN_URL=

# Anthropic API: the assistant (also needs: pip3 install -r requirements.txt)
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=

# Port for the web server (default 8765)
# PORT=8765
